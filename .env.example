# Copy to .env and adjust. Never commit your real .env.

# Host port the web app is published on
BURROW_PORT=3000

# Let more people register after the first (owner) account
ALLOW_SIGNUP=false

# Set true when running behind an HTTPS reverse proxy (Caddy, Traefik, nginx)
TRUST_PROXY=false

# Refuse to fetch LAN/localhost URLs (turn on if you enable sign-ups)
BLOCK_PRIVATE_URLS=false

# ── Optional AI auto-tagging ──
# Leave AI_PROVIDER empty to disable.
#
# Claude:
#   AI_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   AI_MODEL=claude-opus-5-5        (or claude-haiku-5-5 for much cheaper tagging)
#
# Local (start with: docker compose --profile ollama up -d):
#   AI_PROVIDER=ollama
#   AI_MODEL=llama3.2
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
