{
  "name": "Burrow",
  "short_name": "Burrow",
  "description": "Your self-hosted bookmarks, notes and archive",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#12111a",
  "theme_color": "#7c5cff",
  "icons": [
    { "src": "/icons/192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Favorites", "url": "/#/favorites", "icons": [{ "src": "/icons/192.png", "sizes": "192x192" }] },
    { "name": "Notes", "url": "/#/notes", "icons": [{ "src": "/icons/192.png", "sizes": "192x192" }] }
  ]
}
